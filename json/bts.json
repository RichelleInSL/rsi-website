				"references": ["RICHELLE WINTERFELD|1", "DANNEEL HARRIS|5", "STEPHANIE MCMAHON|4", "BRITNEY SPEARS|2", "ELISHA CUTHBERT|1", "EMMA WATSON|2", "EMILY VANCAMP|7", "ASHLEY TISDALE|7", "PATRICIA LEONE|1"]
